<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/selector_fragment">

    <fragment
        android:id="@+id/selector_fragment"
        android:name="com.reilandeubank.unprocess.fragments.SelectorFragment"
        android:label="Selector">

        <action
            android:id="@+id/action_selector_to_camera"
            app:destination="@id/camera_fragment">
            <argument
                android:name="camera_id"
                app:argType="string" />
            <argument
                android:name="pixel_format"
                app:argType="integer" />
            <argument
                android:name="convert_to_jpeg"
                app:argType="boolean" />
        </action>
        <action android:id="@+id/action_selector_to_gallery" app:destination="@id/gallery_fragment" />

    </fragment>

    <fragment android:id="@+id/gallery_fragment"
        android:name="com.reilandeubank.unprocess.fragments.GalleryFragment"
        android:label="Mis fotos" />

    <fragment
        android:id="@+id/camera_fragment"
        android:name="com.reilandeubank.unprocess.fragments.CameraFragment"
        android:label="Camera">

        <action android:id="@+id/action_camera_to_gallery" app:destination="@id/gallery_fragment" />

        <argument
            android:name="camera_id"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="pixel_format"
            app:argType="integer"
            app:nullable="false" />

        <argument
            android:name="convert_to_jpeg"
            app:argType="boolean"
            app:nullable="false" />


    </fragment>

</navigation>
