<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B0E10">

    <com.reilandeubank.unprocess.utils.AutoFitSurfaceView
        android:id="@+id/view_finder" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_gravity="center" />

    <com.reilandeubank.unprocess.fragments.CameraGridOverlay
        android:id="@+id/composition_grid" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone" />

    <View android:id="@+id/overlay" android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.reilandeubank.unprocess.fragments.FocusExposureOverlay
        android:id="@+id/focus_exposure_overlay" android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Tocá la imagen para enfocar y ajustá la exposición junto al punto" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:background="#A60B0E10"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingLeft="12dp" android:paddingTop="8dp"
        android:paddingRight="12dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/back_button" android:layout_width="48dp"
            android:layout_height="48dp" android:gravity="center" android:text="←"
            android:textColor="#FFFFFF" android:textSize="26sp" android:clickable="true"
            android:focusable="true" android:contentDescription="Volver a formatos" />
        <TextView android:id="@+id/format_label" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"
            android:textStyle="bold" android:letterSpacing="0.04"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/pro_toggle" android:layout_width="54dp"
            android:layout_height="44dp" android:background="@drawable/pro_chip_idle"
            android:gravity="center" android:text="PRO" android:textColor="#D8EDB0"
            android:textSize="13sp" android:textStyle="bold" android:clickable="true"
            android:focusable="true" android:contentDescription="Abrir controles Pro" />
        <TextView android:id="@+id/flash_button" android:layout_width="88dp"
            android:layout_height="48dp" android:gravity="center" android:text="Flash: No"
            android:textColor="#D8EDB0" android:textSize="12sp"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="#C90B0E10"
        android:gravity="center" android:orientation="vertical"
        android:paddingLeft="14dp" android:paddingTop="10dp"
        android:paddingRight="14dp" android:paddingBottom="16dp">

        <LinearLayout android:id="@+id/pro_panel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:background="@drawable/pro_panel" android:orientation="vertical"
            android:padding="12dp" android:visibility="gone">
            <TextView android:id="@+id/pro_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:text="PRO  ·  Ajustes de captura" android:textColor="#AFBCC0"
                android:textSize="11sp" android:letterSpacing="0.10" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/iso_control" style="@style/ProToolButton"
                    android:text="ISO" />
                <TextView android:id="@+id/shutter_control" style="@style/ProToolButton"
                    android:layout_marginLeft="6dp" android:text="S" />
                <TextView android:id="@+id/focus_control" style="@style/ProToolButton"
                    android:layout_marginLeft="6dp" android:text="MF" />
                <TextView android:id="@+id/wb_control" style="@style/ProToolButton"
                    android:layout_marginLeft="6dp" android:text="WB" />
                <TextView android:id="@+id/grid_control" style="@style/ProToolButton"
                    android:layout_marginLeft="6dp" android:text="GRID" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:id="@+id/pro_value" android:layout_width="72dp"
                    android:layout_height="wrap_content" android:text="Auto"
                    android:textColor="#D8EDB0" android:textSize="13sp"
                    android:textStyle="bold" />
                <SeekBar android:id="@+id/pro_slider" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1"
                    android:max="100" android:progressTint="#D8EDB0"
                    android:thumbTint="#D8EDB0" />
                <TextView android:id="@+id/pro_auto" android:layout_width="54dp"
                    android:layout_height="44dp" android:gravity="center"
                    android:text="AUTO" android:textColor="#D8EDB0"
                    android:textSize="11sp" android:textStyle="bold"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <TextView android:id="@+id/pro_detail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="#9EADB0" android:textSize="11sp" />
        </LinearLayout>

        <TextView android:id="@+id/capture_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textColor="#FFFFFF" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/gallery_shortcut" android:layout_width="0dp"
                android:layout_height="72dp" android:layout_weight="1"
                android:clickable="true" android:focusable="true"
                android:contentDescription="Ver fotos anteriores">
                <ImageView android:id="@+id/latest_photo" android:layout_width="58dp"
                    android:layout_height="58dp" android:layout_gravity="center_vertical"
                    android:background="@drawable/pro_chip_idle"
                    android:contentDescription="Última foto" android:scaleType="centerCrop" />
                <TextView android:id="@+id/latest_photo_label" android:layout_width="58dp"
                    android:layout_height="58dp" android:layout_gravity="center_vertical"
                    android:gravity="center" android:text="FOTOS"
                    android:textColor="#D8EDB0" android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <ImageButton android:id="@+id/capture_button" android:layout_width="80dp"
                android:layout_height="80dp" android:background="@drawable/ic_shutter"
                android:contentDescription="@string/capture" android:scaleType="fitCenter" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end"
                android:text="UNPROCESS" android:textColor="#748085"
                android:textSize="9sp" android:letterSpacing="0.10" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
